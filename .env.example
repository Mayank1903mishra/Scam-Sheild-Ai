# Application
APP_ENV=development

# Database (SQLite for MVP)
DATABASE_URL=sqlite:///./scamshield.db

# Upload limits
MAX_UPLOAD_MB=5

# Image pixel limits (reject images larger than this before decoding)
MAX_IMAGE_PIXELS=25000000
MAX_IMAGE_DIMENSION=10000

# OCR (local Tesseract, no API keys). Leave empty to auto-detect from
# PATH and common install locations; set the full path to tesseract.exe otherwise.
TESSERACT_CMD=
OCR_TIMEOUT_SECONDS=30

# CORS - allowed frontend origins for local development.
# Comma-separated (or a JSON array). Covers both Vite dev ports used by
# this repo: 3000 (npm run dev) and 5173 (README default).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# External intelligence lookups (I4C advisories, Google Safe Browsing).
# Public read-only pages/API; failures never block an analysis.
INTEL_LOOKUPS_ENABLED=true
INTEL_TIMEOUT_SECONDS=3
INTEL_CACHE_SECONDS=1800
# Empty = Safe Browsing reported as "disabled" (no request is made).
GOOGLE_SAFE_BROWSING_API_KEY=

# Data retention (days)
RETENTION_DAYS=30

# Store user content after PII masking (true/false)
STORE_CONTENT=false

# Demo mode - enables mock/placeholder behaviour, visibly labelled "DEMO"
DEMO_MODE=false

# Rate limiting (requests per minute)
RATE_LIMIT=30/minute